# ==============================================================================
# Cricbuzz LiveStats - Environment Configuration Template (.env.example)
# Copy this file to .env and configure local values as needed.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration (SQLite confirmed default for local development)
DB_ENGINE=sqlite
DB_NAME=cricbuzz.db

# API Integration Configuration (Stage 11)
# Default is OFFLINE_MODE=True (uses local synthetic demonstration fixtures)
OFFLINE_MODE=True

# Active Cricket Data Provider: 'cricketdata' (recommended free tier) or 'rapidapi'
CRICKET_API_PROVIDER=cricketdata

# Option A: CricketData.org (RECOMMENDED for Students - 100 hits/day, NO credit card needed)
# Sign up free at https://cricketdata.org to get your lifetime key
CRICKETDATA_API_KEY=your_cricketdata_api_key_here

# Option B: RapidAPI Cricbuzz (Requires RapidAPI account and credit card for overage hold)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com

# HTTP and Caching Settings
API_TIMEOUT_SECONDS=10
API_CACHE_TTL_SECONDS=60
